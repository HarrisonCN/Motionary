{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/npm/motionary@15/scripts/scene-v3.schema.json",
  "$comment": "draft, may change before 16.0 (15.9 preview: motionary/scene/v3-preview validates with validateSceneV3)",
  "title": "motionary-scene v3 (draft)",
  "description": "Draft of the 16.0 scene format: Scene v2 plus nested compositions (type \"comp\"), components as layers (type \"component\" + components) and first-class breakpoint variants. Track and group layers are the v2 ones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "layers"
  ],
  "$defs": {
    "trackOrGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "enum": [
            "track",
            "group"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 2048
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "locked": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "easing": {
          "type": "string",
          "maxLength": 200
        },
        "preset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "options": {
          "type": "object"
        },
        "component": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "props"
          ],
          "properties": {
            "tag": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*-[a-z0-9-]*$",
              "maxLength": 128
            },
            "props": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(--[A-Za-z0-9_-]+|[a-zA-Z][A-Za-z0-9_-]*)$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "maxLength": 2048
                  }
                ]
              }
            }
          }
        },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "time",
              "props"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "time": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000
              },
              "easing": {
                "type": "string",
                "maxLength": 200
              },
              "composite": {
                "enum": [
                  "replace",
                  "add",
                  "accumulate"
                ]
              },
              "props": {
                "type": "object",
                "maxProperties": 64,
                "propertyNames": {
                  "pattern": "^(--[A-Za-z0-9_-]+|[a-zA-Z][A-Za-z0-9_-]*)$",
                  "not": {
                    "enum": [
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "maxLength": 2048
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "target"
                  ]
                },
                {
                  "required": [
                    "start"
                  ]
                },
                {
                  "required": [
                    "duration"
                  ]
                },
                {
                  "required": [
                    "easing"
                  ]
                },
                {
                  "required": [
                    "keyframes"
                  ]
                },
                {
                  "required": [
                    "preset"
                  ]
                },
                {
                  "required": [
                    "effect"
                  ]
                },
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "component"
                  ]
                }
              ]
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "keyframes",
                  "preset"
                ]
              },
              {
                "required": [
                  "keyframes",
                  "effect"
                ]
              },
              {
                "required": [
                  "preset",
                  "effect"
                ]
              }
            ]
          }
        }
      ]
    },
    "comp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "layers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 2048
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "locked": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        },
        "type": {
          "const": "comp"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "timeRemap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "offset": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000
            },
            "rate": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 16
            }
          },
          "description": "content time t plays at start + (t - offset) / rate"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 2048
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "locked": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        },
        "type": {
          "const": "component"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "muted": {
                "type": "boolean"
              },
              "props": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "layer": {
      "oneOf": [
        {
          "$ref": "#/$defs/trackOrGroup"
        },
        {
          "$ref": "#/$defs/comp"
        },
        {
          "$ref": "#/$defs/component"
        }
      ]
    }
  },
  "properties": {
    "format": {
      "const": "motionary-scene"
    },
    "version": {
      "const": 3
    },
    "name": {
      "type": "string",
      "maxLength": 2048
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000000
    },
    "loop": {
      "type": "boolean"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          }
        },
        "easing": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          }
        },
        "spring": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stiffness",
              "damping",
              "mass"
            ],
            "properties": {
              "stiffness": {
                "type": "number",
                "minimum": 0
              },
              "damping": {
                "type": "number",
                "minimum": 0
              },
              "mass": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "components": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]{1,128}$"
      },
      "maxProperties": 256,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layers"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 2048
          },
          "layers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/layer"
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "media"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minWidth": {
                "type": "number",
                "minimum": 0
              },
              "maxWidth": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "layers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "muted": {
                  "type": "boolean"
                },
                "distanceScale": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "timeScale": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "maxLength": 200
        },
        "version": {
          "type": "integer"
        }
      }
    },
    "meta": {}
  }
}
