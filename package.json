    "size:check": "node scripts/size.mjs --check",
    "sync:exports": "node scripts/sync-exports.mjs",
    "bench": "node scripts/bench.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
