{
  "name": "use-scroll-animate",
  "version": "2.0.1",
  "description": "A lightweight, high-performance, dependency-free scroll animation library for modern web.",
  "type": "module",
  "main": "./dist/index.cjs",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/solid.d.ts",
        "default": "./dist/solid.js"
      },
      "require": {
        "types": "./dist/solid.d.cts",
        "default": "./dist/solid.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "docs",
    "dist",
    "README.md",
    "README_zh.md",
    "README_ja.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs -w",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check:exports": "node scripts/check-exports.mjs",
    "lint:package": "publint && attw --pack . --profile node16",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:exports",
    "size:check": "node scripts/size.mjs --check",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "scroll",
    "animation",
    "intersection-observer",
    "lightweight",
    "vanilla-js",
    "typescript",
    "frontend",
    "ui",
    "scroll-progress",
    "stagger",
    "timeline",
    "svelte",
    "solid",
    "web-component",
    "custom-element",
    "scroll-timeline"
  ],
  "author": "HarrisonCN",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarrisonCN/use-scroll-animate.git"
  },
  "bugs": {
    "url": "https://github.com/HarrisonCN/use-scroll-animate/issues"
  },
  "homepage": "https://github.com/HarrisonCN/use-scroll-animate#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.25",
    "rollup": "^4.60.0",
    "rollup-plugin-dts": "^6.5.1",
    "solid-js": "^1.9.16",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "solid-js": ">=1.6.0",
    "svelte": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
