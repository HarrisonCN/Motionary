    "build": "npm run clean && PART=code node --max-old-space-size=5120 ./node_modules/rollup/dist/bin/rollup -c rollup.config.mjs && PART=dts SLICE=0/3 node --max-old-space-size=4096 ./node_modules/rollup/dist/bin/rollup -c rollup.config.mjs && PART=dts SLICE=1/3 node --max-old-space-size=4096 ./node_modules/rollup/dist/bin/rollup -c rollup.config.mjs && PART=dts SLICE=2/3 node --max-old-space-size=4096 ./node_modules/rollup/dist/bin/rollup -c rollup.config.mjs && node scripts/gen-manifest.mjs",
