{
  "name": "use-scroll-animate",
  "version": "1.3.0",
  "description": "A lightweight, high-performance, dependency-free scroll animation library for modern web.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README_zh.md",
    "README_ja.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "scroll",
    "animation",
    "intersection-observer",
    "lightweight",
    "vanilla-js",
    "typescript",
    "frontend",
    "ui"
  ],
  "author": "HarrisonCN",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarrisonCN/use-scroll-animate.git"
  },
  "bugs": {
    "url": "https://github.com/HarrisonCN/use-scroll-animate/issues"
  },
  "homepage": "https://github.com/HarrisonCN/use-scroll-animate#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "jsdom": "^26.1.0",
    "rollup": "^4.60.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vitest": "^3.2.7"
  }
}
