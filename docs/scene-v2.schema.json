{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/npm/motionary@14/docs/scene-v2.schema.json",
  "title": "motionary-scene v2 (draft)",
  "description": "Draft of the 14.0 scene format: one document for timeline layers, <usa-player> tracks, component motion props and motion tokens. Values may reference tokens as \"{duration.fast}\".",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "layers"
  ],
  "properties": {
    "format": {
      "const": "motionary-scene"
    },
    "version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "maxLength": 2048
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000000
    },
    "loop": {
      "type": "boolean"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          }
        },
        "easing": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          }
        },
        "spring": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stiffness",
              "damping",
              "mass"
            ],
            "properties": {
              "stiffness": {
                "type": "number",
                "minimum": 0
              },
              "damping": {
                "type": "number",
                "minimum": 0
              },
              "mass": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "maxLength": 200
        },
        "version": {
          "type": "integer"
        }
      }
    },
    "meta": {},
    "layers": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "type": {
            "enum": [
              "track",
              "group"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 2048
          },
          "parent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "locked": {
            "type": "boolean"
          },
          "muted": {
            "type": "boolean"
          },
          "solo": {
            "type": "boolean"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "duration": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "easing": {
            "type": "string",
            "maxLength": 200
          },
          "preset": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "effect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "options": {
            "type": "object"
          },
          "component": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "props"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*-[a-z0-9-]*$",
                "maxLength": 128
              },
              "props": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(--[A-Za-z0-9_-]+|[a-zA-Z][A-Za-z0-9_-]*)$",
                  "not": {
                    "enum": [
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "maxLength": 2048
                    }
                  ]
                }
              }
            }
          },
          "keyframes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "time",
                "props"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "time": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000000
                },
                "easing": {
                  "type": "string",
                  "maxLength": 200
                },
                "composite": {
                  "enum": [
                    "replace",
                    "add",
                    "accumulate"
                  ]
                },
                "props": {
                  "type": "object",
                  "maxProperties": 64,
                  "propertyNames": {
                    "pattern": "^(--[A-Za-z0-9_-]+|[a-zA-Z][A-Za-z0-9_-]*)$",
                    "not": {
                      "enum": [
                        "constructor",
                        "prototype"
                      ]
                    }
                  },
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "maxLength": 2048
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "group"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "target"
                    ]
                  },
                  {
                    "required": [
                      "start"
                    ]
                  },
                  {
                    "required": [
                      "duration"
                    ]
                  },
                  {
                    "required": [
                      "easing"
                    ]
                  },
                  {
                    "required": [
                      "keyframes"
                    ]
                  },
                  {
                    "required": [
                      "preset"
                    ]
                  },
                  {
                    "required": [
                      "effect"
                    ]
                  },
                  {
                    "required": [
                      "options"
                    ]
                  },
                  {
                    "required": [
                      "component"
                    ]
                  }
                ]
              }
            }
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "keyframes",
                    "preset"
                  ]
                },
                {
                  "required": [
                    "keyframes",
                    "effect"
                  ]
                },
                {
                  "required": [
                    "preset",
                    "effect"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  }
}
